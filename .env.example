# Keep Fastify on loopback. The Pi installer exposes it through a dedicated
# tailnet-only Tailscale HTTPS listener without opening a LAN port.
HOMEDASH_HOST=127.0.0.1
HOMEDASH_PORT=1910

SNOWRAVEN_URL=http://127.0.0.1:1620
LLMDASH_URL=http://127.0.0.1:8787

# Optional home fallback. Set both coordinates or leave both blank.
HOME_LATITUDE=
HOME_LONGITUDE=
HOME_LABEL=Home

WEATHER_UNIT=fahrenheit
EBIRD_RADIUS_KM=50
EBIRD_WINDOW_DAYS=14
EBIRD_TARGET_LIMIT=5
BOOKMARKS_PATH=./config/bookmarks.json
