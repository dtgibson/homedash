# Keep Fastify on loopback. The Pi installer exposes it through a dedicated
# tailnet-only Tailscale HTTPS listener without opening a LAN port.
HOMEDASH_HOST=127.0.0.1
HOMEDASH_PORT=1910
# Exact browser origins allowed to read or replace the private bookmark document.
# Add the installed Tailscale HTTPS origin, including :1910.
HOMEDASH_ALLOWED_ORIGINS=http://127.0.0.1:1910,http://127.0.0.1:5173

SNOWRAVEN_URL=http://127.0.0.1:1620
LLMDASH_URL=http://127.0.0.1:8787
# Optional private browser destination for the fixed /launch/llmdash action.
# Set an absolute http(s) URL on the host; it is independent from LLMDASH_URL.
LLMDASH_LAUNCH_URL=

# Optional fixed NOAA station override. Leave blank to select the nearest eligible
# station from the same current, recent last-known, or Home location used by weather.
# Keep the station ID private. The label applies only to a fixed override; automatic
# selection displays NOAA's validated public station name.
TIDE_STATION_ID=
TIDE_STATION_LABEL=Local tide

# Optional home fallback. Set both coordinates or leave both blank.
HOME_LATITUDE=
HOME_LONGITUDE=
HOME_LABEL=Home

WEATHER_UNIT=fahrenheit
EBIRD_RADIUS_KM=16
EBIRD_WINDOW_DAYS=14
EBIRD_TARGET_LIMIT=5
# Keep writable bookmark state in a dedicated directory.
BOOKMARKS_PATH=./state/bookmarks/bookmarks.json
